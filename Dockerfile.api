# FastAPI Admin Server
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[admin]" boto3

# Copy application code
COPY src/ ./src/
COPY admin-ui/dist ./admin-ui/dist

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/api/health', timeout=2)"

# Run FastAPI
CMD ["uvicorn", "wine_crawler.admin.app:create_app", "--host", "0.0.0.0", "--port", "8000", "--factory"]
